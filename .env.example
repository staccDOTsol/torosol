# Copy to .env and populate with your own Solana Mainnet RPC + Jupiter API key
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
BACKUP_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=YOUR_JUPITER_API_KEY
MANAGER_KEYPAIR=~/your-manager-keypair.json
ORCA_AUTH_KEYPAIR=~/.config/solana/id.json
